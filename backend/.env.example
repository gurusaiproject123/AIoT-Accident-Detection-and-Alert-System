# AIoT Accident Detection and Alert System - Backend Environment Template
# Copy this file to backend/.env and fill in real values locally.
# Never commit backend/.env or real credentials to Git.

ENVIRONMENT=development
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Workflow timers (seconds)
CANCELLATION_WINDOW_SECONDS=30
HOSPITAL_ACK_TIMEOUT_SECONDS=180
MAX_ESCALATION_LEVEL=3

