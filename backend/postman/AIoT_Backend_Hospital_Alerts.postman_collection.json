{
  "info": {
    "name": "AIoT Backend - Hospital Alerts (Victor)",
    "_postman_id": "7b665640-7f09-43f6-9e73-707788990007",
    "description": "Credential-free Postman collection for Section 7: Hospital Alerts and Live Updates (backend-hospital-alerts). Configure variables in your local Postman Environment; never commit real passwords or access tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "supabase_url", "value": "https://your-project-ref.supabase.co" },
    { "key": "supabase_publishable_key", "value": "your-publishable-key" },
    { "key": "access_token", "value": "" },
    { "key": "hospital_id", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "incident_id", "value": "aaaa1111-1111-1111-1111-111111111111" },
    { "key": "alert_id", "value": "00000000-0000-0000-0000-000000000000" }
  ],
  "item": [
    {
      "name": "7. Hospital Alerts & Live Updates",
      "item": [
        {
          "name": "GET /api/hospital/alerts - List Assigned Hospital Alerts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/hospital/alerts",
              "host": ["{{base_url}}"],
              "path": ["api", "hospital", "alerts"]
            }
          }
        },
        {
          "name": "GET /api/alerts/{id} - Get Authorized Alert Notification",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/alerts/{{alert_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "alerts", "{{alert_id}}"]
            }
          }
        },
        {
          "name": "POST /api/alerts/{id}/acknowledge - Confirm Receipt",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/alerts/{{alert_id}}/acknowledge",
              "host": ["{{base_url}}"],
              "path": ["api", "alerts", "{{alert_id}}", "acknowledge"]
            }
          }
        },
        {
          "name": "POST /api/alerts/{id}/accept - Accept Response",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/alerts/{{alert_id}}/accept",
              "host": ["{{base_url}}"],
              "path": ["api", "alerts", "{{alert_id}}", "accept"]
            }
          }
        },
        {
          "name": "POST /api/alerts/{id}/decline - Decline with Mandatory Reason",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Trauma unit at full capacity.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/alerts/{{alert_id}}/decline",
              "host": ["{{base_url}}"],
              "path": ["api", "alerts", "{{alert_id}}", "decline"]
            }
          }
        },
        {
          "name": "POST /api/admin/incidents/{id}/notify - Superuser Manual Route",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hospital_id\": \"{{hospital_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/incidents/{{incident_id}}/notify",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "incidents", "{{incident_id}}", "notify"]
            }
          }
        }
      ]
    }
  ]
}

